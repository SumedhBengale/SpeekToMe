{
  "identifier": "me.speekto.SpeekToMe",
  "productName": "me.speekto.SpeekToMe",
  "build": {
    "beforeBundleCommand": "sh src-tauri/build-linux-keywatch.sh"
  },
  "bundle": {
    "linux": {
      "deb": {
        "desktopTemplate": "linux.desktop.hbs",
        "files": {
          "/usr/libexec/speektome-keywatch": "../target/release/speektome-keywatch",
          "/usr/share/polkit-1/actions/me.speekto.SpeekToMe.policy": "linux-keywatch.policy"
        },
        "depends": [
          "libatspi2.0-0t64 | libatspi2.0-0",
          "libpulse0",
          "libasound2t64 | libasound2",
          "libsecret-1-0",
          "libdbus-1-3",
          "libgtk-layer-shell0"
        ]
      },
      "rpm": {
        "release": "5",
        "desktopTemplate": "linux.rpm.desktop.hbs",
        "files": {
          "/usr/libexec/speektome-keywatch": "../target/release/speektome-keywatch",
          "/usr/share/polkit-1/actions/me.speekto.SpeekToMe.policy": "linux-keywatch.policy"
        },
        "depends": [
          "libatspi.so.0()(64bit)",
          "libpulse-simple.so.0()(64bit)",
          "libpulse.so.0()(64bit)",
          "libasound.so.2()(64bit)",
          "libsecret-1.so.0()(64bit)",
          "libdbus-1.so.3()(64bit)",
          "libgtk-layer-shell.so.0()(64bit)"
        ]
      }
    }
  }
}
