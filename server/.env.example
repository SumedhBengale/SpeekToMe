GROQ_API_KEY=your_groq_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPINFRA_API_KEY=your_deepinfra_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
WAFER_API_KEY=your_wafer_api_key_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
BACKEND_URL=http://localhost:8000
DATABASE_URL=speektome.db
DATABASE_TOKEN=token_here
FRONTEND_URL=http://localhost:8080

# AWS SES Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
SES_SENDER_EMAIL=noreply@yourdomain.com

# Razorpay Configuration
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_PLAN_ID=your_razorpay_plan_id_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
SPEEKTOME_DEBUG=true

# Security Configuration
ENCRYPTION_KEY=your_aes_encryption_key_32bytes_here
TURNSTILE_SECRET=your_cloudflare_turnstile_secret_here

# Valkey / Redis Configuration
VALKEY_URL=redis://127.0.0.1:6379/0

# TypeSafe Jev: contextual validation of vocabulary choices on the main server
TYPESAFE_API_KEY=your_typesafe_api_key_here
TYPESAFE_MODEL=jev-1.13.0
# Timeout, saturation, and rate-limit failures fall back to vocabulary engine choices.
TYPESAFE_TIMEOUT_MS=400
TYPESAFE_MAX_CONCURRENT=16
# Set these to the account limits; 0 disables the local request/token limiter.
TYPESAFE_RPS=0
TYPESAFE_TPS=0

# Serverless GPU diarization (deployment/modal-diarization). Generate with
# `python deployment/modal-diarization/provision.py server/.env`; unset PUBLIC_KEY
# to fall back to the private CPU gateway (SPEEKTOME_DIARIZATION_TOKEN_FILE).
SPEEKTOME_DIARIZATION_URL=https://<workspace>--speektome-diarization-api.<region>.modal.run
SPEEKTOME_DIARIZATION_TOKEN=<bearer key, 48+ random bytes>
SPEEKTOME_DIARIZATION_PUBLIC_KEY=<base64 X25519 public key of the diarizer>
SPEEKTOME_DIARIZATION_MODAL_KEY=<Modal proxy token ID, wk-...>
SPEEKTOME_DIARIZATION_MODAL_SECRET=<Modal proxy token secret, ws-...>
SPEEKTOME_DIARIZATION_CONCURRENCY=8

# Signs live meeting word batches the desktop keeps and uploads with the audio,
# so the finished meeting reuses the live transcript. 32 random bytes, base64
# (openssl rand -base64 32). After rotating, keep the old value in _PREVIOUS
# until meetings recorded under it have been processed.
SPEEKTOME_LIVE_TRANSCRIPT_KEY=<base64 32-byte key>
SPEEKTOME_LIVE_TRANSCRIPT_KEY_PREVIOUS=

# Self-hosted streaming ASR gateway (websocket). Unset disables that provider
# and streaming falls through to the hosted providers.
SPEEKTOME_SELF_HOSTED_STREAM_URL=wss://asr-gateway.example.com/v1/stream

# Private CPU diarization gateway, used when SPEEKTOME_DIARIZATION_PUBLIC_KEY is
# unset. Set SPEEKTOME_DIARIZATION_URL (above) to its private address, e.g.
# http://<diarization-private-ip>:8081, and point this at the bearer-token file.
SPEEKTOME_DIARIZATION_TOKEN_FILE=/etc/speektome-diarization/token

# ASR GPU fleet controller and spot orchestrator
ENABLE_SPOT_ORCHESTRATOR=false
SPEEKTOME_FLEET_URL=http://127.0.0.1:8095
SPEEKTOME_FLEET_CONFIG=/etc/speektome-fleet/fleet.json
SPEEKTOME_WORKER_TOKEN_FILE=/etc/speektome-fleet/worker.token
SPOT_AMI_ID=ami-xxxxxxxxxxxxxxxxx
SPOT_KEY_NAME=your_ec2_key_pair_name
SPOT_SECURITY_GROUP=sg-xxxxxxxxxxxxxxxxx
SPOT_USER_DATA=

# Encrypted personal storage (Cloudflare R2)
R2_ACCOUNT_ID=your_r2_account_id_here
R2_BUCKET=your_r2_bucket_name_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
MASTER_KEY_SECRET_ARN=
PRIVACY_USE_INSTANCE_ROLE=false

# Optional extra LLM providers
OPENROUTER_API_KEY=your_openrouter_api_key_here
AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key_here

# Session and acknowledgement signing secrets (generate with: openssl rand -base64 32)
SESSION_SECRET=your_session_secret_here
SPEEKTOME_ACK_SECRET=your_ack_secret_here

# Benchmarks and research scripts only (never used by the server)
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here
SPEEKTOME_INFERENCE_BUCKET=your_s3_bucket_for_gateway_releases
BENCH_SSH_KEY=~/.ssh/your_key
BENCH_SSH_JUMP=user@bastion.example.com
BENCH_SSH_TARGET=ubuntu@worker.example.com
