{
  "manifest_version": 3,
  "name": "SpeekTo.Me Client",
  "version": "1.0.0",
  "description": "Voice dictation, translation and meeting summary client.",
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "storage",
    "identity",
    "tabCapture"
  ],
  "host_permissions": [
    "https://api.speekto.me/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "SpeekTo.Me Settings"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
