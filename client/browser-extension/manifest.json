{
  "manifest_version": 3,
  "name": "SpeekTo.Me Client",
  "version": "1.0.1",
  "description": "Voice dictation, translation and meeting summary client.",
  "permissions": [
    "activeTab",
    "scripting",
    "offscreen",
    "storage",
    "identity",
    "tabCapture",
    "notifications"
  ],
  "host_permissions": [
    "https://api.speekto.me/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "index.html",
    "default_title": "SpeekTo.Me Settings",
    "default_icon": "assets/icons/logo.png"
  },
  "commands": {
    "toggle-dictation": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Start or stop SpeekTo.Me dictation"
    }
  },
  "icons": {
    "16": "assets/icons/logo.png",
    "48": "assets/icons/logo.png",
    "128": "assets/icons/logo.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
