{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SpeekTo.Me",
  "version": "0.1.0",
  "identifier": "com.speektome.app",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SpeekTo.Me Settings",
        "width": 640,
        "height": 440,
        "resizable": true,
        "visible": false,
        "transparent": true,
        "decorations": true,
        "skipTaskbar": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
