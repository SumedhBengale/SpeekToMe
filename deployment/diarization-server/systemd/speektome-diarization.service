[Unit]
Description=SpeekToMe CPU diarization gateway and resident INT8 runtime
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=speektome-diarization
Group=speektome-diarization
WorkingDirectory=/opt/speektome-diarization
ExecStart=/opt/speektome-diarization/venv/bin/python -u /opt/speektome-diarization/gateway.py
Environment=OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=2 OMP_THREAD_LIMIT=2 PYTHONDONTWRITEBYTECODE=1
Restart=always
RestartSec=3
TimeoutStopSec=15
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/speektome-diarization
MemoryHigh=2800M
MemoryMax=3G
TasksMax=64
LimitNOFILE=1024
StandardOutput=journal
StandardError=journal
SyslogIdentifier=speektome-diarization

[Install]
WantedBy=multi-user.target
