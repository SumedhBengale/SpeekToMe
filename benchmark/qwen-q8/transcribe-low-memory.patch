+static void verify_flash_graph(ggml_backend_sched_t sched, ggml_cgraph * graph, const char * stage) {
+    if (std::getenv("TRANSCRIBE_VERIFY_FLASH") == nullptr) return;
+    static std::unordered_map<std::string, bool> seen;
+    if (seen[stage]) return;
+    seen[stage] = true;
+    int count = 0, cuda_count = 0;
+    for (int i = 0; i < ggml_graph_n_nodes(graph); ++i) {
+        ggml_tensor * node = ggml_graph_node(graph, i);
+        if (node->op != GGML_OP_FLASH_ATTN_EXT) continue;
+        ++count;
+        auto backend = ggml_backend_sched_get_tensor_backend(sched, node);
+        if (backend && std::strncmp(ggml_backend_name(backend), "CUDA", 4) == 0) ++cuda_count;
+    }
+    std::fprintf(stderr, "FLASH_VERIFY stage=%s flash_nodes=%d cuda_nodes=%d\n", stage, count, cuda_count);
+}
